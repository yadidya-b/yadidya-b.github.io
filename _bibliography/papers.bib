@article{makar2025, 
  year     = {2025}, 
  title    = {Seasonal Variability of Internal Tides and Associated Energy Budget Over the Eastern Arabian Sea: Observations and Modeling}, 
  author   = {Makar, Pragnya and Rao, A. D. and Yadidya, B. and Pant, Vimlesh}, 
  journal  = {Journal of Geophysical Research: Oceans}, 
  issn     = {2169-9275}, 
  doi      = {10.1029/2024jc021529}, 
  abstract = {The seasonal variability of Internal tides ({ITs}) in the Eastern Arabian Sea was studied in detail using in‐situ observations and numerical modeling. Moored buoy observations identified M2 and K1 as the predominant tidal constituents, succeeded by S2 and O1. The 3D‐ Massachusetts Institute of Technology General Circulation Model is used to study the seasonal changes in the generation, propagation, and dissipation of {ITs}. We found that {ITs} are primarily generated along the continental shelf‐slope break, with prominent generation sites off Mumbai in the north, around the Lakshadweep region, and near the Maldives in the south. Stratification varies both seasonally and regionally, strengthening from north to south. The enhancement of {IT} available potential energy and horizontal kinetic energy is observed during the pre‐monsoon season in the north and during the monsoon season in the south, attributed to increased stratification. Shelf‐slope areas off Mumbai and near the Maldives contribute approximately 66\% of the total barotropic‐to‐baroclinic energy conversion. Energy flux patterns indicate a southwestward propagation from the Mumbai region and a westward propagation from the Maldives. Semidiurnal energy conversion and associated fluxes generally exceed those of diurnal energy across most seasons. These findings underscore that seasonal variability is primarily driven by changes in stratification, offering essential insights into the dynamics of {ITs} in this region. This study explores the seasonal changes in Internal tides ({IT})s in the Eastern Arabian Sea using measurements from ocean buoys and computer modeling. Internal tides are underwater waves generated by tidal forces and are important because they help mix ocean waters, affecting ocean life and climate. We found that the main types of tidal waves in this region are the M2 and K1 tides. These {ITs} are mostly generated along the edges of the continental shelf, particularly near Mumbai, the Lakshadweep region, and the Maldives. Seasonal and regional changes in ocean density stratification influence these {ITs}, with stronger layering found in the south. The strongest generation of {ITs} occurs in spring and summer, and most of the energy from these waves moves southwest from Mumbai and westward from the Maldives. The highest {IT} activity is observed during the pre‐monsoon season in the north and the monsoon season in the south, primarily due to stronger stratification. Our findings show that changes in stratification across seasons are key drivers of {ITs} in this area, helping us better understand the seasonal behavior and impact of these underwater waves. The study provides a detailed analysis of the seasonal variability of diurnal and semidiurnal Internal tides ({ITs}) in the eastern Arabian Sea {IT} generation is higher in the north during pre‐monsoon and in the south during monsoon due to stronger stratification Energy budget analysis shows strong seasonal variation at generation sites, with variability up to 1.03 {GW} in the Maldives region The study provides a detailed analysis of the seasonal variability of diurnal and semidiurnal Internal tides ({ITs}) in the eastern Arabian Sea {IT} generation is higher in the north during pre‐monsoon and in the south during monsoon due to stronger stratification Energy budget analysis shows strong seasonal variation at generation sites, with variability up to 1.03 {GW} in the Maldives region}, 
  number   = {7}, 
  volume   = {130}
}
