@article{yadidya2025ess, 
  year     = {2025}, 
  title    = {Advancing Internal Tide Correction for {SWOT} Cal/Val: The Role of Ocean Forecasts}, 
  author   = {Yadidya, Badarvada and Arbic, Brian K. and Shriver, Jay F. and Zaron, Edward D. and Buijsman, Maarten C. and Carrère, Loren and Tchilibou, Michel and Uchida, Takaya}, 
  journal  = {Earth and Space Science}, 
  issn     = {2333-5084}, 
  doi      = {10.1029/2025ea004511}, 
  abstract = {Internal tides are sub‐surface inertia‐gravity waves that generate significant sea surface height signals detectable with satellite altimetry. The Surface Water and Ocean Topography ({SWOT}) mission provides an exciting opportunity to characterize these signals with unprecedented spatial detail. Separating tidal and non‐tidal oceanic signals is necessary for achieving the {SWOT} mission's objective of advancing our understanding of mesoscale and submesoscale processes. In this study, we evaluate the performance of a data‐assimilative {HYbrid} Coordinate Ocean Model ({HYCOM}) forecast system in resolving both phase‐locked and non‐phase‐locked internal tides during the {SWOT} Cal/Val period. We compare {HYCOM}'s effectiveness to the High‐Resolution Empirical Tide model ({HRET}22), which is currently used for internal tide corrections but only accounts for the phase‐locked component. {HYCOM} achieves an average of 5\% greater reduction in phase‐locked internal tide variance and a 24.6\% greater total variance reduction compared to {HRET}22 by also accounting for non‐phase‐locked internal tides. At the M2 \$\{{\textbackslash} mathrm\{M\}\}_\{2\}\$ frequency, {HYCOM} reduces up to 73\% of total internal tide variance in {SWOT} observations, including substantial contributions from the non‐phase‐locked component. Despite these advances, persistent residuals remain in energetic, topographically complex areas, pointing to the continued need for improved modeling and data assimilation. These findings demonstrate the crucial role of forecast models in advancing internal tide mapping and significantly improving altimetric data correction in the era of {SWOT} oceanography. Internal tides are generated when regular ocean tides flow over underwater features such as ridges and seamounts, creating subsurface waves that lead to noticeable changes on the sea surface. Satellites like the recently launched Surface Water and Ocean Topography ({SWOT}) mission can detect these changes with unparalleled spatial detail. While {SWOT}'s detailed measurements offer exciting new ways to study oceanographic processes, the internal tide signals they capture can obscure important features such as ocean currents and eddies. By using the advanced {HYCOM} forecasting system to filter out these internal tide signals, our research allows scientists to more accurately analyze the high‐resolution observations collected by {SWOT}, making it easier to investigate the ocean's dynamic currents and smaller‐scale phenomena. {HYCOM} excels by accurately predicting and removing internal tide signals, effectively reducing the regular, predictable phase‐locked tides, and showing remarkable skill in managing the complex, unpredictable, and irregular non‐phase‐locked tidal patterns. The challenge of measuring these hard‐to‐predict internal tides is now more achievable with the detailed insights provided by the {SWOT} satellite, opening up new avenues for research. Forecast models are central to this progress, as they effectively decipher complex tidal patterns to distinguish internal tides from other ocean signals more accurately. Ocean forecast models such as {HYCOM} can be used to make mission‐critical internal tide corrections in {SWOT} data An advantage of ocean forecast models is that they can predict non‐phase‐locked as well as phase‐locked internal tides {HYCOM} can remove up to 24.6\% more internal tide (phase‐locked + non‐phase locked) variance compared to the tidal correction used now Ocean forecast models such as {HYCOM} can be used to make mission‐critical internal tide corrections in {SWOT} data An advantage of ocean forecast models is that they can predict non‐phase‐locked as well as phase‐locked internal tides {HYCOM} can remove up to 24.6\% more internal tide (phase‐locked + non‐phase locked) variance compared to the tidal correction used now}, 
  number   = {11}, 
  volume   = {12}
}
